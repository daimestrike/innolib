# Если приложение нужно опубликовать под префиксом, например https://portal.x5.ru/innolib/
# Приложение само понимает префикс, отдельной настройки не нужно.
location /innolib/ {
    proxy_pass http://127.0.0.1:8080/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 90s;   # запас на ответ LLM
    client_max_body_size 2m;
}
