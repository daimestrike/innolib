# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Порт на хосте
PORT=8080

# Загружать демо-кейсы, если база пустая (1 — да, 0 — нет)
SEED_DEMO=1

# Токен администратора: включает удаление кейсов и документов через API
# (заголовок X-Admin-Token). Пусто — удаление выключено.
ADMIN_TOKEN=

# --- Модель (разбор карточек и консультант) ---
# Любой OpenAI-совместимый API внутри контура. Адрес — до /v1 включительно.
# Пусто — мастер и консультант работают в упрощённом режиме без модели.
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
# Отдельная модель для чата, если нужна другая (по умолчанию = LLM_MODEL)
LLM_CHAT_MODEL=
LLM_TIMEOUT=90
# Дополнительные параметры запроса в JSON, например отключить рассуждения у Qwen3:
# LLM_EXTRA_JSON={"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_JSON=
# HTTPS с внутренним сертификатом: путь к CA (в Docker — путь внутри контейнера) или LLM_VERIFY_TLS=0
LLM_CA_BUNDLE=
LLM_VERIFY_TLS=1
# 1 — ходить к API через системный прокси (HTTPS_PROXY). По умолчанию напрямую.
LLM_USE_SYSTEM_PROXY=0

# --- Поиск для консультанта (RAG) ---
# Сколько фрагментов подставлять в контекст
RAG_TOP_K=6
# Модель эмбеддингов (необязательно). Без неё работает поиск BM25 по ключевым словам.
EMBED_MODEL=
# Адрес API эмбеддингов, если отличается от LLM_URL
EMBED_URL=
