# Скопируйте в .env и заполните.

# Порт на хосте
PORT=8080

# Загружать демо-кейсы, если база пустая (1 — да, 0 — нет)
SEED_DEMO=1

# Токен администратора: включает удаление кейсов через API (заголовок X-Admin-Token).
# Пусто — удаление выключено.
ADMIN_TOKEN=

# --- ИИ-разбор ответов (необязательно) ---
# Любой OpenAI-совместимый endpoint внутри контура: vLLM, Ollama, LiteLLM и т.п.
# Адрес указывается до /v1 включительно, приложение само добавит /chat/completions.
# Пусто — мастер работает без ИИ, карточка заполняется из ответов как есть.
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
# Для HTTPS с внутренним сертификатом: путь к CA внутри контейнера, либо LLM_VERIFY_TLS=0
LLM_CA_BUNDLE=
LLM_VERIFY_TLS=1
